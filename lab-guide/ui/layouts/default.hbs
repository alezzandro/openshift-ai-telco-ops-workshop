<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if page.title}}{{{page.title}}} :: {{/if}}{{site.title}}</title>
  <link rel="stylesheet" href="{{{uiRootPath}}}/css/site.css">
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <a class="logo" href="{{{siteRootPath}}}/index.html">{{site.title}}</a>
      <span class="header-note">Red Hat OpenShift AI 3.5</span>
    </div>
  </header>
  <div id="env-banner" class="env-banner">Loading lab environment…</div>
  <div class="layout">
    <nav class="nav" aria-label="Module navigation">
      {{#each page.navigation}}
        {{> nav-tree}}
      {{/each}}
    </nav>
    <main class="main">
      <article class="doc">
        <h1>{{{page.title}}}</h1>
        {{{page.contents}}}
      </article>
      <nav class="pagination">
        {{#if page.previous}}<a class="prev" href="{{relativize page.previous.url}}">← {{page.previous.content}}</a>{{/if}}
        {{#if page.next}}<a class="next" href="{{relativize page.next.url}}">{{page.next.content}} →</a>{{/if}}
      </nav>
    </main>
  </div>
  <footer class="footer">
    Public workshop content. Official product names: Red Hat OpenShift, Red Hat OpenShift AI.
  </footer>
  <script src="{{{uiRootPath}}}/js/env-banner.js"></script>
</body>
</html>
